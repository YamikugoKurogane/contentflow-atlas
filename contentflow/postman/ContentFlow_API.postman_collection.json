        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario_id\": \"user_1\",\n  \"contenido\": \"Publicación creada desde Postman\",\n  \"categoria\": \"Tecnología\",\n  \"tipo\": \"Texto\",\n  \"hashtags\": [\n    \"#innovacion\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"pub_id\", pm.response.json()._id);"
            ]
          }
        }
